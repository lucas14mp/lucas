<web-app>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <filter>
        <filter-name>FiltroAutenticacao</filter-name>
        <filter-class>br.com.bb.cbe.autenticacao.FiltroAutenticacao</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FiltroAutenticacao</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <error-page>
        <exception-type>java.lang.NumberFormatException</exception-type>
        <location>/errors/customError.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/errors/pageNotFound.jsp</location>
    </error-page>
    
</web-app>